APP_NAME=Crypto Divergence Analyzer
ENVIRONMENT=local
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# ── Data provider ────────────────────────────────────────────────
# "mock"    => deterministic synthetic data, no network, no keys (default)
# "binance" => live Binance USDT-M futures public API (real market data)
DATA_PROVIDER=mock

# ── Binance API keys (OPTIONAL) ──────────────────────────────────
# Public market data works WITHOUT keys. A free READ-ONLY key only raises
# your rate limits (recommended for full-universe scans).
# Create at: Binance > API Management > enable "Reading" ONLY.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Coinglass is NOT required — Binance's own endpoints cover OI / long-short
# ratio / funding for free. Leave blank.
COINGLASS_API_KEY=

# ── YQBY 分析師 (LLM) ────────────────────────────────────────────
# Blank => the analyst chat is scaffolded but disabled (returns a notice).
# Fill in to enable, then restart the backend.
ANTHROPIC_API_KEY=
ANALYST_MODEL=claude-sonnet-4-6

# ── Live fetch tuning (only used when DATA_PROVIDER=binance) ──────
BINANCE_BASE_URL=https://fapi.binance.com
# Top-N USDT perpetuals by 24h volume to scan. Each symbol ~5 rate-limited
# requests; raise gradually once a background refresh exists.
SCAN_UNIVERSE_SIZE=40
# Response cache TTL (s). Above the 30s frontend poll => repeat scans are free.
DATA_CACHE_TTL_SECONDS=90
# Max concurrent in-flight requests during a scan fan-out.
SCAN_MAX_WORKERS=8
# Soft cap on outbound requests/sec to stay under Binance IP limits.
BINANCE_MAX_REQUESTS_PER_SECOND=8
